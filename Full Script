function refreshObjectList(filterText)
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    yPos = 0

    local validSelected = {}
    for _, obj in ipairs(selectedObjects) do
        if obj and obj.Parent then table.insert(validSelected, obj) end
    end
    selectedObjects = validSelected

    local filterLower = filterText:lower()
    local function matches(obj)
        return filterText == "" or obj.Name:lower():find(filterLower)
    end

    if #selectedObjects > 0 then
        renderHeader(T("selHeader"), Color3.fromRGB(255, 200, 120))
        for _, obj in ipairs(selectedObjects) do
            if matches(obj) then createRow(obj, 0, true) end
        end
    end

    local allObjects = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Model") then
            table.insert(allObjects, d)
        end
    end

    table.sort(allObjects, function(a, b)
        local aFav = favorites[a] and true or false
        local bFav = favorites[b] and true or false
        if aFav ~= bFav then return aFav end
        return a.Name:lower() < b.Name:lower()
    end)

    local hasFav = false
    for _, obj in ipairs(allObjects) do
        if favorites[obj] and matches(obj) then
            hasFav = true
            break
        end
    end

    if hasFav then
        renderHeader(T("favHeader"), Color3.fromRGB(255, 210, 60))
        local favCount = 0
        for _, obj in ipairs(allObjects) do
            if favorites[obj] and matches(obj) then
                favCount = favCount + 1
                if favCount > 100 then break end
                createRow(obj, 0, false)
            end
        end
    end

    local otherCount = 0
    local otherHeaderShown = false
    for _, obj in ipairs(allObjects) do
        if not favorites[obj] and matches(obj) then
            if not otherHeaderShown then
                renderHeader(T("allHeader"), Color3.fromRGB(180, 180, 200))
                otherHeaderShown = true
            end
            otherCount = otherCount + 1
            if otherCount > 200 then break end
            createRow(obj, 0, false)
        end
    end

    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 10)
end

