-- // ИЗБРАННОЕ \\
local FAV_FILE = "explorer_favorites.txt"
local favorites = setmetatable({}, { __mode = "k" })
local expanded = setmetatable({}, { __mode = "k" })
local selectedObjects = {}

local function loadFavorites()
    local paths = {}
    if isfile and isfile(FAV_FILE) then
        local ok, data = pcall(readfile, FAV_FILE)
        if ok and data then
            for line in string.gmatch(data, "[^\r\n]+") do
                paths[line] = true
            end
        end
    end
    local claimed = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Model") then
            local p = d:GetFullName()
            if paths[p] and not claimed[p] then
                favorites[d] = true
                claimed[p] = true
            end
        end
    end
end

local function saveFavorites()
    if writefile then
        local lines = {}
        local seen = {}
        for obj in pairs(favorites) do
            if obj and obj.Parent then
                local p = obj:GetFullName()
                if not seen[p] then
                    seen[p] = true
                    table.insert(lines, p)
                end
            end
        end
        pcall(writefile, FAV_FILE, table.concat(lines, "\n"))
    end
end

